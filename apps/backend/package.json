{
  "name": "backend",
  "version": "1.0.50",
  "module": "src/index.js",
  "scripts": {
    "lint": "eslint .",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply quizly --local",
    "db:migrate:remote": "wrangler d1 migrations apply quizly --remote",
    "db:seed:generate": "bun run scripts/generate-seed-sql.ts",
    "db:seed:local": "wrangler d1 execute quizly --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute quizly --remote --file=./scripts/seed.sql"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.12",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@elysia/cors": "rc",
    "@quizly/types": "workspace:*",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "elysia": "rc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.151.2"
  }
}
